{
  "name": "secoundhand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file=.env scripts/migrate.mjs up",
    "migrate:status": "node --env-file=.env scripts/migrate.mjs status",
    "migrate:baseline": "node --env-file=.env scripts/migrate.mjs baseline",
    "migrate:prd": "node --env-file=.env scripts/migrate.mjs up --prd",
    "migrate:prd:status": "node --env-file=.env scripts/migrate.mjs status --prd",
    "seed": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "test:db": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
