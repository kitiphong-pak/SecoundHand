NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# สองตัวล่างใช้เฉพาะคำสั่ง migrate — ตัวแอปไม่ได้ใช้เลย (แอปคุยกับ Supabase ผ่าน SUPABASE_SECRET_KEY)
# หาได้จาก Supabase Dashboard > ปุ่ม Connect ด้านบน > Session pooler > URI
# ถ้ารหัสผ่านมีอักขระพิเศษ ต้อง percent-encode ก่อน (@ = %40, # = %23, ...)

# ฐานข้อมูล UAT — ปลายทางของ npm run migrate
DATABASE_URL=postgresql://postgres.uat-ref:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ฐานข้อมูล PRD — ปลายทางของ npm run migrate:prd (แยกตัวแปรกันคนละตัวเพื่อไม่ให้รันผิดตัว)
PRD_DATABASE_URL=postgresql://postgres.prd-ref:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# secret แบบสุ่มยาวๆ — ตั้งเองแล้วเอาไปตั้งซ้ำในตัว scheduler ที่ยิงมาที่ /api/cron/order-timeouts
# (Vercel Cron จะแนบให้อัตโนมัติเป็น Authorization: Bearer $CRON_SECRET ถ้าตั้ง env นี้ไว้)
CRON_SECRET=
