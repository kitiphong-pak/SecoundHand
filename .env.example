NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ใช้เฉพาะ npm run migrate — ตัวแอปไม่ได้ใช้ค่านี้เลย (แอปคุยกับ Supabase ผ่าน SUPABASE_SECRET_KEY)
# หาได้จาก Supabase Dashboard > Project Settings > Database > Connection string > URI
# ต้องชี้ไปยัง environment ที่ตั้งใจจะรัน migration ด้วย เช่นถ้าจะรันกับ UAT ก็ต้องเป็น URL ของ UAT
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# secret แบบสุ่มยาวๆ — ตั้งเองแล้วเอาไปตั้งซ้ำในตัว scheduler ที่ยิงมาที่ /api/cron/order-timeouts
# (Vercel Cron จะแนบให้อัตโนมัติเป็น Authorization: Bearer $CRON_SECRET ถ้าตั้ง env นี้ไว้)
CRON_SECRET=
